{
  "$schema": "https://turbo.build/schema.json",
  // Shared tooling configs are not package-graph dependencies of every task
  // (e.g. lint reads `@mms/eslint-config`, typecheck reads the TS presets, the
  // app build reads the Tailwind theme). Hash them globally so a tooling change
  // always invalidates the tasks it can affect instead of replaying stale cache.
  "globalDependencies": ["tooling/**", "scripts/eslint-ts-compat.cjs", "tsconfig.base.json"],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "JWT_SECRET",
    "NODE_ENV",
    "PORT",
    "MMS_APP_DOMAIN",
    "PUPPETEER_SKIP_DOWNLOAD"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["VITE_APP_DOMAIN", "MMS_APP_DOMAIN", "MMS_REACT_COMPILER"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "lint": {
      "dependsOn": [],
      "outputs": []
    },
    "db:migrate": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    }
  }
}

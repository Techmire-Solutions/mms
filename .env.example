# MMS root environment — consumed by docker-compose.yml.
# Copy to .env and fill in real values before `docker compose up`.
# NEVER commit a real .env. Generate secrets with: openssl rand -hex 32

# --- Required (compose fails fast without these) ---
POSTGRES_PASSWORD=change-me-strong-postgres-password
# Password for the non-superuser application role (compose init script). Use only
# URL-safe characters: it is embedded in DATABASE_URL.
MMS_DB_PASSWORD=change-me-strong-app-password
REDIS_PASSWORD=generate-one-with-openssl-rand-hex-24
JWT_SECRET=generate-one-with-openssl-rand-hex-32

# --- Optional (sane defaults via :-, only override if needed) ---
POSTGRES_USER=postgres
POSTGRES_DB=mms
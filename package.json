{
  "name": "mms-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=mms-frontend --filter=mms-backend",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "pnpm --filter e2e-tests exec playwright test",
    "check:i18n": "pnpm --filter mms-backend exec tsx ../../scripts/i18n/check-translations.ts",
    "check:i18n-unused": "node scripts/i18n/check-unused-keys.mjs",
    "verify:rules": "node scripts/verify-rules-integrity.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:pwa": "node scripts/check-pwa-precache.mjs",
    "check:migration-indexes": "node scripts/check-migration-indexes.mjs",
    "check:migration-hygiene": "node scripts/check-migration-hygiene.mjs",
    "check:db-projections": "node scripts/check-db-projections.mjs",
    "check:code-norms": "node scripts/check-code-norms.mjs",
    "check:frontend-structure": "node scripts/check-frontend-structure.mjs",
    "check:work-directory": "node scripts/check-work-directory.mjs",
    "check:shared-ui": "node scripts/check-shared-ui.mjs",
    "check:shared-purity": "bash .agent/skills/mms-shared-package/scripts/check-shared-exports.sh",
    "check:shared-structure": "node scripts/check-shared-structure.mjs",
    "check:faculty-domain": "node scripts/check-faculty-domain.mjs",
    "check:backend-boundaries": "node scripts/check-backend-boundaries.mjs",
    "check:backend-structure": "node scripts/check-backend-structure.mjs",
    "check:migrations-forward-only": "node scripts/check-migrations-forward-only.mjs",
    "check:secrets": "node scripts/check-staged-secrets.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:tdd-pairing": "node scripts/check-tdd-pairing.mjs",
    "check:ratchet-baselines": "node scripts/ci/check-ratchet-baselines.mjs",
    "test:scripts": "node --test scripts/ci/*.test.mjs scripts/lib/db-projections-core.test.mjs",
    "sync:skills-index": "node scripts/sync-skill-index.mjs",
    "ci:local": "bash scripts/ci/local-ci.sh",
    "ci:local:full": "bash scripts/ci/local-ci.sh --full",
    "prepare": "node -e \"try{require('node:child_process').execSync('git config core.hooksPath .githooks',{stdio:'ignore'})}catch{}\""
  },
  "devDependencies": {
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "turbo": "^2.11.9",
    "typescript": "~7.0.2",
    "typescript-v6": "npm:typescript@~6.0.3"
  }
}

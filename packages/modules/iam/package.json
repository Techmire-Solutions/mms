{
  "name": "@mms/mod-iam",
  "version": "1.0.0",
  "private": true,
  "description": "IAM vertical module: users, roles/permissions, organization invites and platform operator IAM. Audience-separated shared/backend/frontend exports.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./backend/platform": {
      "import": "./dist/backend/platform.router.js",
      "types": "./dist/backend/platform.router.d.ts"
    },
    "./backend/tenant": {
      "import": "./dist/backend/tenant.router.js",
      "types": "./dist/backend/tenant.router.d.ts"
    },
    "./backend/tenant/deps": {
      "import": "./dist/backend/tenant/deps.js",
      "types": "./dist/backend/tenant/deps.d.ts"
    },
    "./backend/tenant/iamPort": {
      "import": "./dist/backend/tenant/iamPort.js",
      "types": "./dist/backend/tenant/iamPort.d.ts"
    },
    "./backend/tenant/repository": {
      "import": "./dist/backend/tenant/repository/index.js",
      "types": "./dist/backend/tenant/repository/index.d.ts"
    },
    "./backend/tenant/repository/*": {
      "import": "./dist/backend/tenant/repository/*.js",
      "types": "./dist/backend/tenant/repository/*.d.ts"
    },
    "./backend/tenant/services": {
      "import": "./dist/backend/tenant/services/index.js",
      "types": "./dist/backend/tenant/services/index.d.ts"
    },
    "./backend/tenant/services/*": {
      "import": "./dist/backend/tenant/services/*.js",
      "types": "./dist/backend/tenant/services/*.d.ts"
    },
    "./backend/tenant/use-cases": {
      "import": "./dist/backend/tenant/use-cases/index.js",
      "types": "./dist/backend/tenant/use-cases/index.d.ts"
    },
    "./backend/tenant/use-cases/*": {
      "import": "./dist/backend/tenant/use-cases/*.js",
      "types": "./dist/backend/tenant/use-cases/*.d.ts"
    },
    "./backend/tenant/users": {
      "import": "./dist/backend/tenant/users.router.js",
      "types": "./dist/backend/tenant/users.router.d.ts"
    },
    "./frontend/platform": "./src/frontend/platform/index.ts",
    "./frontend/tenant": "./src/frontend/tenant/index.ts",
    "./package.json": "./package.json",
    "./shared": {
      "import": "./dist/shared/index.js",
      "types": "./dist/shared/index.d.ts"
    },
    "./frontend/tenant/*": {
      "import": "./src/frontend/tenant/*",
      "types": "./src/frontend/tenant/*"
    },
    "./frontend/tenant/hooks/*": "./src/frontend/tenant/hooks/*.ts",
    "./frontend/tenant/components/*": "./src/frontend/tenant/components/*.tsx",
    "./frontend/tenant/lib/*": [
      "./src/frontend/tenant/lib/*.ts",
      "./src/frontend/tenant/lib/*.tsx"
    ],
    "./frontend/tenant/lib/usersDescriptor": "./src/frontend/tenant/lib/usersDescriptor.tsx",
    "./frontend/tenant/host": "./src/frontend/tenant/host.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc --noEmit -p tsconfig.frontend.json",
    "typecheck": "tsc --noEmit -p tsconfig.backend.json && tsc --noEmit -p tsconfig.frontend.json",
    "lint": "node -r ../../../scripts/eslint-ts-compat.cjs node_modules/eslint/bin/eslint.js --cache --cache-strategy content --cache-location node_modules/.cache/eslint/ . --quiet --rule '@typescript-eslint/no-explicit-any:off'",
    "test": "vitest run --config vitest.backend.config.ts --passWithNoTests && vitest run --config vitest.frontend.config.ts"
  },
  "dependencies": {
    "@mms/be-core": "workspace:*",
    "@mms/contracts": "workspace:*",
    "@mms/db": "workspace:*",
    "@mms/fe-core": "workspace:*",
    "@mms/ui": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "zod": "catalog:",
    "drizzle-orm": "catalog:",
    "@ts-rest/fastify": "^3.52.1",
    "@ts-rest/core": "^3.52.1",
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.78.0",
    "@tanstack/react-virtual": "^3.14.28",
    "@hookform/resolvers": "^7.0.8",
    "react-hook-form": "^7.92.0",
    "react-router-dom": "catalog:"
  },
  "peerDependencies": {
    "fastify": "^5.12.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@mms/eslint-config": "workspace:*",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "fastify": "catalog:",
    "happy-dom": "^21.0.4",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "~7.0.2",
    "vite": "catalog:",
    "vitest": "5.1.1"
  }
}

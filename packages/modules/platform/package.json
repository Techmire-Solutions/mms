{
  "name": "@mms/mod-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Platform console vertical module: workspace provisioning/admin, console settings, branding, integrations (SMS/email), messaging campaigns, LLM/ERD/schema tools, backup and audit surfaces.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./shared": {
      "import": "./dist/shared/index.js",
      "types": "./dist/shared/index.d.ts"
    },
    "./frontend/vite-env.d": "./src/frontend/vite-env.d.ts",
    "./package.json": "./package.json",
    "./backend/platform/router": {
      "import": "./dist/backend/platform/router.js",
      "types": "./dist/backend/platform/router.d.ts"
    },
    "./backend/platform/deps": {
      "import": "./dist/backend/platform/deps.js",
      "types": "./dist/backend/platform/deps.d.ts"
    },
    "./backend/platform/repository": {
      "import": "./dist/backend/platform/repository/index.js",
      "types": "./dist/backend/platform/repository/index.d.ts"
    },
    "./backend/platform/use-cases": {
      "import": "./dist/backend/platform/use-cases/index.js",
      "types": "./dist/backend/platform/use-cases/index.d.ts"
    },
    "./backend/platform/services": {
      "import": "./dist/backend/platform/services/index.js",
      "types": "./dist/backend/platform/services/index.d.ts"
    },
    "./backend/platform/services/*": {
      "import": "./dist/backend/platform/services/*.js",
      "types": "./dist/backend/platform/services/*.d.ts"
    },
    "./backend/platform/repository/*": {
      "import": "./dist/backend/platform/repository/*.js",
      "types": "./dist/backend/platform/repository/*.d.ts"
    },
    "./backend/platform/repository/db/*": {
      "import": "./dist/backend/platform/repository/db/*.js",
      "types": "./dist/backend/platform/repository/db/*.d.ts"
    },
    "./backend/platform/routes/*": {
      "import": "./dist/backend/platform/routes/*.js",
      "types": "./dist/backend/platform/routes/*.d.ts"
    },
    "./backend/platform/use-cases/*": {
      "import": "./dist/backend/platform/use-cases/*.js",
      "types": "./dist/backend/platform/use-cases/*.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc --noEmit -p tsconfig.frontend.json",
    "typecheck": "tsc --noEmit -p tsconfig.backend.json && tsc --noEmit -p tsconfig.frontend.json",
    "lint": "node -r ../../../scripts/eslint-ts-compat.cjs node_modules/eslint/bin/eslint.js --cache --cache-strategy content --cache-location node_modules/.cache/eslint/ . --quiet",
    "test": "vitest run --config vitest.backend.config.ts && vitest run --config vitest.frontend.config.ts --passWithNoTests",
    "test:db": "vitest run --config vitest.db.config.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/jwt": "^10.2.9",
    "@mms/be-core": "workspace:*",
    "@mms/contracts": "workspace:*",
    "@mms/db": "workspace:*",
    "@mms/fe-core": "workspace:*",
    "@mms/ui": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@ts-rest/core": "^3.52.1",
    "@ts-rest/fastify": "^3.52.1",
    "drizzle-orm": "catalog:",
    "nodemailer": "^10.6.1",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "fastify": "^5.12.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@mms/eslint-config": "workspace:*",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "fastify": "catalog:",
    "happy-dom": "^21.0.4",
    "pg": "^8.23.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "~7.0.2",
    "vite": "catalog:",
    "vitest": "5.1.1"
  }
}

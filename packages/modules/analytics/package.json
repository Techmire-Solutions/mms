{
  "name": "@mms/mod-analytics",
  "version": "1.0.0",
  "private": true,
  "description": "@mms/mod-analytics - saved reports and analytics",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js"
    },
    "./backend/repository": {
      "types": "./dist/backend/repository/index.d.ts",
      "import": "./dist/backend/repository/index.js"
    },
    "./backend/use-cases": {
      "types": "./dist/backend/use-cases/index.d.ts",
      "import": "./dist/backend/use-cases/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.backend.json",
    "lint": "node -r ../../../scripts/eslint-ts-compat.cjs node_modules/eslint/bin/eslint.js --cache --cache-strategy content --cache-location node_modules/.cache/eslint/ . --quiet",
    "test": "vitest run --config vitest.backend.config.ts --passWithNoTests"
  },
  "peerDependencies": {
    "fastify": "^5.12.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@mms/eslint-config": "workspace:*",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "fastify": "catalog:",
    "happy-dom": "^21.0.4",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "~7.0.2",
    "vite": "catalog:",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "@mms/be-core": "workspace:*",
    "@mms/contracts": "workspace:*",
    "@mms/db": "workspace:*",
    "drizzle-orm": "catalog:"
  }
}

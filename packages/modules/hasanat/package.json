{
  "name": "@mms/mod-hasanat",
  "version": "1.0.0",
  "private": true,
  "description": "Hasanat vertical module: point awards, cards, tiers, batches, distributions, redemptions, catalog and setup configuration.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./shared": {
      "import": "./dist/shared/index.js",
      "types": "./dist/shared/index.d.ts"
    },
    "./backend/tenant": {
      "import": "./dist/backend/tenant.router.js",
      "types": "./dist/backend/tenant.router.d.ts"
    },
    "./backend/use-cases": {
      "import": "./dist/backend/use-cases/index.js",
      "types": "./dist/backend/use-cases/index.d.ts"
    },
    "./backend/repository": {
      "import": "./dist/backend/repository/index.js",
      "types": "./dist/backend/repository/index.d.ts"
    },
    "./backend/routes": {
      "import": "./dist/backend/routes/index.js",
      "types": "./dist/backend/routes/index.d.ts"
    },
    "./backend/services": {
      "import": "./dist/backend/services/index.js",
      "types": "./dist/backend/services/index.d.ts"
    },
    "./backend/jobs": {
      "import": "./dist/backend/jobs/index.js",
      "types": "./dist/backend/jobs/index.d.ts"
    },
    "./backend/domain": {
      "import": "./dist/backend/domain/index.js",
      "types": "./dist/backend/domain/index.d.ts"
    },
    "./backend/ports": {
      "import": "./dist/backend/ports.js",
      "types": "./dist/backend/ports.d.ts"
    },
    "./backend/deps": {
      "import": "./dist/backend/deps.js",
      "types": "./dist/backend/deps.d.ts"
    },
    "./backend/service": {
      "import": "./dist/backend/hasanat.service.js",
      "types": "./dist/backend/hasanat.service.d.ts"
    },
    "./frontend/tenant": "./src/frontend/tenant/index.ts",
    "./frontend/components/*": "./src/frontend/components/*.tsx",
    "./frontend/tenant/lib/*": "./src/frontend/tenant/lib/*.ts",
    "./frontend/tenant/hooks/*": "./src/frontend/tenant/hooks/*.ts",
    "./frontend/tenant/components/*": "./src/frontend/tenant/components/*.tsx",
    "./frontend/tenant/host": "./src/frontend/tenant/host.tsx",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc --noEmit -p tsconfig.frontend.json",
    "typecheck": "tsc --noEmit -p tsconfig.backend.json && tsc --noEmit -p tsconfig.frontend.json",
    "lint": "node -r ../../../scripts/eslint-ts-compat.cjs node_modules/eslint/bin/eslint.js --cache --cache-strategy content --cache-location node_modules/.cache/eslint/ . --quiet --rule '@typescript-eslint/no-explicit-any:off'",
    "test": "vitest run --config vitest.backend.config.ts --passWithNoTests && vitest run --config vitest.frontend.config.ts --passWithNoTests",
    "test:db": "vitest run --config vitest.db.config.ts"
  },
  "dependencies": {
    "@mms/be-core": "workspace:*",
    "@mms/contracts": "workspace:*",
    "@mms/db": "workspace:*",
    "@mms/fe-core": "workspace:*",
    "@mms/ui": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@ts-rest/core": "^3.52.1",
    "@ts-rest/fastify": "^3.52.1",
    "drizzle-orm": "catalog:",
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.78.0",
    "recharts": "^3.11.0",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "fastify": "^5.12.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@mms/eslint-config": "workspace:*",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "fastify": "catalog:",
    "happy-dom": "^21.0.4",
    "pg": "^8.23.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "~7.0.2",
    "vite": "catalog:",
    "vitest": "5.1.0"
  }
}

{
  "name": "@mms/shared",
  "version": "1.0.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tenantUtils": {
      "import": "./dist/tenantUtils.js",
      "default": "./dist/tenantUtils.js",
      "types": "./dist/tenantUtils.d.ts"
    },
    "./translations/en": {
      "import": "./dist/i18n/appTranslationsEn.js",
      "default": "./dist/i18n/appTranslationsEn.js",
      "types": "./dist/i18n/appTranslationsEn.d.ts"
    },
    "./translations/ar": {
      "import": "./dist/i18n/appTranslationsAr.js",
      "default": "./dist/i18n/appTranslationsAr.js",
      "types": "./dist/i18n/appTranslationsAr.d.ts"
    },
    "./translations/ur": {
      "import": "./dist/i18n/appTranslationsUr.js",
      "default": "./dist/i18n/appTranslationsUr.js",
      "types": "./dist/i18n/appTranslationsUr.d.ts"
    },
    "./translations/fa": {
      "import": "./dist/i18n/appTranslationsFa.js",
      "default": "./dist/i18n/appTranslationsFa.js",
      "types": "./dist/i18n/appTranslationsFa.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/typecheck.tsbuildinfo",
    "lint": "node -r ../../scripts/eslint-ts-compat.cjs node_modules/eslint/bin/eslint.js --cache --cache-strategy content --cache-location node_modules/.cache/eslint/ . --quiet",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ts-rest/core": "^3.52.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}

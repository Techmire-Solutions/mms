{
  "name": "@mms/db",
  "version": "1.0.0",
  "private": true,
  "description": "MMS data layer: Drizzle schema, forward-only DDL migrations, seed fixtures, soft-delete helpers and the tenant-scoped database client.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./schema": {
      "import": "./dist/schema.js",
      "types": "./dist/schema.d.ts"
    },
    "./schema/*": {
      "import": "./dist/schema/*.js",
      "types": "./dist/schema/*.d.ts"
    },
    "./client": {
      "import": "./dist/client.js",
      "types": "./dist/client.d.ts"
    },
    "./context": {
      "import": "./dist/context.js",
      "types": "./dist/context.d.ts"
    },
    "./soft-delete": {
      "import": "./dist/soft-delete/index.js",
      "types": "./dist/soft-delete/index.d.ts"
    },
    "./migrations": {
      "import": "./dist/migrations.js",
      "types": "./dist/migrations.d.ts"
    },
    "./seed": {
      "import": "./dist/seed/index.js",
      "types": "./dist/seed/index.d.ts"
    },
    "./testing": {
      "import": "./dist/testing.js",
      "types": "./dist/testing.d.ts"
    },
    "./request-context": {
      "import": "./dist/request-context.js",
      "types": "./dist/request-context.d.ts"
    },
    "./client/db": {
      "import": "./dist/dbClient.js",
      "types": "./dist/dbClient.d.ts"
    },
    "./client/connection": {
      "import": "./dist/dbConnection.js",
      "types": "./dist/dbConnection.d.ts"
    },
    "./client/transactions": {
      "import": "./dist/dbTransactions.js",
      "types": "./dist/dbTransactions.d.ts"
    },
    "./context/tenant": {
      "import": "./dist/tenant-context.js",
      "types": "./dist/tenant-context.d.ts"
    },
    "./context/scope-guard": {
      "import": "./dist/tenantScopeGuard.js",
      "types": "./dist/tenantScopeGuard.d.ts"
    },
    "./context/guards": {
      "import": "./dist/tenantTransactionGuards.js",
      "types": "./dist/tenantTransactionGuards.d.ts"
    },
    "./package.json": "./package.json",
    "./transactionSideEffects": {
      "import": "./dist/transactionSideEffects.js",
      "types": "./dist/transactionSideEffects.d.ts"
    },
    "./genericRelationalConditions": {
      "import": "./dist/genericRelationalConditions.js",
      "types": "./dist/genericRelationalConditions.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "node -r ../../scripts/eslint-ts-compat.cjs node_modules/eslint/bin/eslint.js --cache --cache-strategy content --cache-location node_modules/.cache/eslint/ . --quiet",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@mms/contracts": "workspace:*",
    "drizzle-orm": "catalog:",
    "pg": "^8.23.1",
    "pino": "catalog:"
  },
  "devDependencies": {
    "@mms/eslint-config": "workspace:*",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "eslint": "^10.15.0",
    "typescript": "~7.0.2",
    "vitest": "5.1.0"
  }
}

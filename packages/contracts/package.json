{
  "name": "@mms/contracts",
  "version": "1.0.0",
  "description": "MMS contract SSOT: Zod schemas, request/response DTOs, pagination/filter contracts, error codes, domain enums, manifests and pure utilities (no Node-only or browser-only runtime dependencies).",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tenantUtils": {
      "import": "./dist/auth/tenantUtils.js",
      "default": "./dist/auth/tenantUtils.js",
      "types": "./dist/auth/tenantUtils.d.ts"
    },
    "./translations/en": {
      "import": "./dist/i18n/appTranslationsEn.js",
      "default": "./dist/i18n/appTranslationsEn.js",
      "types": "./dist/i18n/appTranslationsEn.d.ts"
    },
    "./translations/ar": {
      "import": "./dist/i18n/appTranslationsAr.js",
      "default": "./dist/i18n/appTranslationsAr.js",
      "types": "./dist/i18n/appTranslationsAr.d.ts"
    },
    "./translations/ur": {
      "import": "./dist/i18n/appTranslationsUr.js",
      "default": "./dist/i18n/appTranslationsUr.js",
      "types": "./dist/i18n/appTranslationsUr.d.ts"
    },
    "./translations/fa": {
      "import": "./dist/i18n/appTranslationsFa.js",
      "default": "./dist/i18n/appTranslationsFa.js",
      "types": "./dist/i18n/appTranslationsFa.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/typecheck.tsbuildinfo",
    "lint": "node -r ../../scripts/eslint-ts-compat.cjs node_modules/eslint/bin/eslint.js --cache --cache-strategy content --cache-location node_modules/.cache/eslint/ . --quiet",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:examinations": "vitest run src/examinations/resultScoring.test.ts src/examinations/examLifecycle.test.ts --coverage --coverage.include=src/examinations/resultScoring.ts --coverage.include=src/examinations/gradeUtils.ts --coverage.include=src/examinations/examLifecycle.ts --coverage.thresholds.lines=95 --coverage.thresholds.statements=95 --coverage.thresholds.functions=95 --coverage.thresholds.branches=83 --coverage.reporter=text-summary"
  },
  "dependencies": {
    "@ts-rest/core": "^3.52.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mms/eslint-config": "workspace:*",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.74.0",
    "vitest": "5.1.1"
  }
}

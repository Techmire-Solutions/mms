#!/usr/bin/env bash
# Git hook: fast pre-commit checks (seconds, staged files only).
# - Staged secrets scan.
# - ESLint (cached) on staged files.
# Typecheck + changed-related unit tests run in .githooks/pre-push (pnpm ci:local).
set -euo pipefail

if [[ "${SKIP_LOCAL_CI:-}" == "1" ]]; then
  echo "⚠ SKIP_LOCAL_CI=1 — skipping pre-commit checks (agents must not set this unless the user asks)."
  exit 0
fi

echo "🔍 Pre-commit: secrets + lint on staged files..."
pnpm run check:secrets
git diff --cached --name-only --diff-filter=ACMR | bash scripts/ci/lint-changed.sh
echo "✅ Pre-commit checks passed."

{
  // Repository-root alias for the shared strictness base. Every package extends
  // `tooling/typescript-config/{node,react}.json`, which both extend
  // `tooling/typescript-config/base.json`; this file keeps the long-lived
  // docs/rules that name `tsconfig.base.json` accurate and gives ad-hoc tooling a
  // stable root path to extend.
  "extends": "./tooling/typescript-config/base.json"
}

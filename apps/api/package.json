{
  "name": "mms-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker": "tsx watch src/worker/index.ts",
    "worker:native": "node --experimental-strip-types src/worker/index.ts",
    "build": "tsc && mkdir -p dist/worker/templates && cp -r src/worker/templates/. dist/worker/templates/",
    "start": "node dist/index.js",
    "worker:start": "node dist/worker/index.js",
    "db:reset": "tsx src/scripts/resetDb.ts",
    "db:migrate": "node dist/scripts/migrateDb.js 2>/dev/null || tsx src/scripts/migrateDb.ts",
    "db:check": "tsx src/scripts/checkMigrations.ts",
    "db:check-rls": "pnpm --filter @mms/db run check:rls-role",
    "db:provision-rls": "pnpm --filter @mms/db run provision:rls-role",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/typecheck.tsbuildinfo",
    "lint": "node -r ../../scripts/eslint-ts-compat.cjs node_modules/eslint/bin/eslint.js --cache --cache-strategy content --cache-location node_modules/.cache/eslint/ src --quiet",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:rls": "vitest run --config vitest.rls.config.ts",
    "audit:verify": "tsx src/scripts/verify-audit-chains.ts",
    "audit:detach": "tsx src/scripts/detach-audit-partition.ts",
    "benchmark:worker": "tsx src/scripts/benchmarkWorkerHeap.ts",
    "audit:partitions": "tsx src/scripts/create-audit-partition.ts",
    "index:concurrent": "tsx src/scripts/createIndexConcurrently.ts",
    "audit:dates": "tsx src/scripts/audit-date-formats.ts",
    "audit:timestamps": "tsx src/scripts/audit-timestamp-columns.ts",
    "audit:enrollment-ssot": "tsx src/scripts/audit-enrollment-ssot.ts",
    "audit:class-references": "tsx src/scripts/audit-class-references.ts",
    "audit:date-columns": "tsx src/scripts/audit-date-columns.ts",
    "audit:finance-date-columns": "tsx src/scripts/audit-finance-date-columns.ts",
    "audit:ledger-balance": "tsx src/scripts/audit-ledger-balance.ts",
    "audit:ledger-currency-balance": "tsx src/scripts/audit-ledger-currency-balance.ts",
    "audit:accounting-batch-runs": "tsx src/scripts/audit-accounting-batch-runs.ts",
    "audit:academic-contract": "tsx src/scripts/audit-academic-contract.ts",
    "backfill:attendance-sections": "tsx src/scripts/backfill-attendance-sections.ts",
    "backfill:date-columns": "tsx src/scripts/backfill-date-columns.ts",
    "purge:selected-modules": "tsx src/scripts/purgeSelectedModules.ts",
    "purge:orphaned-attachments": "tsx src/scripts/sweepOrphanedAttachments.ts",
    "test:db:coverage": "vitest run --config vitest.db.config.ts --coverage --coverage.allowExternal=true --coverage.include='src/worker/sessionLifecycleScheduler.ts' --coverage.include='../../packages/modules/sessions/src/backend/use-cases/**' --coverage.include='../../packages/modules/sessions/src/backend/domain/**' --coverage.include='../../packages/modules/sessions/src/backend/repository/db/session*.ts' --coverage.include='../../packages/modules/sessions/src/backend/routes/session*.ts' --coverage.exclude='**/__tests__/**' --coverage.reportsDirectory=coverage-sessions-db --coverage.reporter=json",
    "test:db:coverage:enrollments": "vitest run --config vitest.db.config.ts --coverage --coverage.allowExternal=true --coverage.include='../../packages/modules/enrollments/src/backend/use-cases/**' --coverage.include='../../packages/modules/enrollments/src/backend/domain/**' --coverage.include='../../packages/modules/enrollments/src/backend/repository/**' --coverage.include='../../packages/modules/enrollments/src/backend/routes/**' --coverage.exclude='**/__tests__/**' --coverage.exclude='**/index.ts' --coverage.reportsDirectory=coverage-enrollments-db --coverage.reporter=json",
    "test:db:coverage:attendance": "vitest run --config vitest.db.config.ts --coverage --coverage.allowExternal=true --coverage.include='../../packages/modules/attendance/src/backend/use-cases/**' --coverage.include='../../packages/modules/attendance/src/backend/domain/**' --coverage.include='../../packages/modules/attendance/src/backend/repository/**' --coverage.include='../../packages/modules/attendance/src/backend/routes/**' --coverage.include='../../packages/modules/attendance/src/backend/services/**' --coverage.exclude='**/__tests__/**' --coverage.exclude='**/index.ts' --coverage.reportsDirectory=coverage-attendance-db --coverage.reporter=json",
    "test:db:concurrency": "node ../../scripts/ci/run-concurrency-suite.mjs",
    "test:db:coverage:examinations": "vitest run --config vitest.db.config.ts --coverage --coverage.allowExternal=true --coverage.include='../../packages/modules/examinations/src/backend/repository/examination*.ts' --coverage.include='../../packages/modules/examinations/src/backend/repository/examResultUpsert.ts' --coverage.include='../../packages/modules/examinations/src/backend/domain/**' --coverage.exclude='**/__tests__/**' --coverage.exclude='**/index.ts' --coverage.reportsDirectory=coverage-examinations-db --coverage.reporter=json-summary --coverage.reporter=text-summary",
    "test:db:coverage:finance": "vitest run --config vitest.db.config.ts --coverage --coverage.allowExternal=true --coverage.include='../../packages/modules/billing/src/backend/use-cases/**' --coverage.include='../../packages/modules/billing/src/backend/domain/**' --coverage.include='../../packages/modules/billing/src/backend/repository/**' --coverage.include='../../packages/modules/billing/src/backend/routes/**' --coverage.exclude='**/__tests__/**' --coverage.exclude='**/index.ts' --coverage.reportsDirectory=coverage-finance-db --coverage.reporter=json",
    "test:db:coverage:accounting": "vitest run --config vitest.db.config.ts --coverage --coverage.allowExternal=true --coverage.include='../../packages/modules/accounting/src/backend/repository/**' --coverage.include='../../packages/modules/accounting/src/backend/routes/**' --coverage.include='../../packages/modules/accounting/src/backend/ledgerPosting/**' --coverage.include='../../packages/modules/accounting/src/backend/accounting.service.ts' --coverage.exclude='**/__tests__/**' --coverage.reportsDirectory=coverage-accounting-db --coverage.reporter=json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/lib-storage": "^3.1175.0",
    "@fastify/compress": "^9.3.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.9",
    "@fastify/multipart": "^10.1.9",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/static": "^10.1.12",
    "@fastify/websocket": "^11.3.7",
    "@mms/be-core": "workspace:*",
    "@mms/contracts": "workspace:*",
    "@mms/db": "workspace:*",
    "@mms/mod-accounting": "workspace:*",
    "@mms/mod-analytics": "workspace:*",
    "@mms/mod-attendance": "workspace:*",
    "@mms/mod-audit": "workspace:*",
    "@mms/mod-billing": "workspace:*",
    "@mms/mod-contacts": "workspace:*",
    "@mms/mod-documents": "workspace:*",
    "@mms/mod-enrollments": "workspace:*",
    "@mms/mod-examinations": "workspace:*",
    "@mms/mod-faculty": "workspace:*",
    "@mms/mod-hasanat": "workspace:*",
    "@mms/mod-iam": "workspace:*",
    "@mms/mod-messaging": "workspace:*",
    "@mms/mod-notifications": "workspace:*",
    "@mms/mod-obligations": "workspace:*",
    "@mms/mod-question-bank": "workspace:*",
    "@mms/mod-sessions": "workspace:*",
    "@mms/mod-students": "workspace:*",
    "@mms/mod-tasks": "workspace:*",
    "@mms/mod-workshops": "workspace:*",
    "@ts-rest/core": "^3.52.1",
    "@ts-rest/fastify": "^3.52.1",
    "@ts-rest/open-api": "^3.52.1",
    "bullmq": "^6.7.8",
    "drizzle-orm": "catalog:",
    "exceljs": "^4.4.0",
    "fastify": "catalog:",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^6.1.0",
    "lru-cache": "^11.5.3",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "pino": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mms/eslint-config": "workspace:*",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "5.1.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.74.0",
    "vitest": "5.1.1",
    "ws": "^8.23.0"
  }
}

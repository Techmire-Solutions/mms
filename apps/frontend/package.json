{
  "name": "mms-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "node -r ../../scripts/eslint-ts-compat.cjs node_modules/eslint/bin/eslint.js --cache --cache-strategy content --cache-location node_modules/.cache/eslint/ . --quiet",
    "lint:fix": "node -r ../../scripts/eslint-ts-compat.cjs node_modules/eslint/bin/eslint.js . --fix",
    "typecheck": "tsc -p ./tsconfig.json --incremental --tsBuildInfoFile node_modules/.cache/tsc/typecheck.tsbuildinfo",
    "test:shard-timings": "vitest run --merge-reports=.vitest-reports --reporter=default --reporter=./src/test/shardTimingsReporter.ts",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview"
  },

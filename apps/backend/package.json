{
  "name": "mms-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker": "tsx watch src/worker/index.ts",
    "worker:native": "node --experimental-strip-types src/worker/index.ts",
    "build": "tsc && rm -rf dist/db/migrations_drizzle && mkdir -p dist/db/migrations_drizzle && cp -r src/db/migrations_drizzle/. dist/db/migrations_drizzle/ && mkdir -p dist/worker/templates && cp -r src/worker/templates/. dist/worker/templates/",
    "start": "node dist/index.js",
    "worker:start": "node dist/worker/index.js",
    "db:reset": "tsx src/scripts/resetDb.ts",
    "db:migrate": "node dist/scripts/migrateDb.js 2>/dev/null || tsx src/scripts/migrateDb.ts",
    "db:check": "tsx src/scripts/checkMigrations.ts",
    "db:check-rls": "tsx src/scripts/checkRlsRole.ts",
    "db:provision-rls": "tsx src/scripts/provisionRlsRole.ts",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/typecheck.tsbuildinfo",
    "lint": "node -r ../../scripts/eslint-ts-compat.cjs node_modules/eslint/bin/eslint.js --cache --cache-strategy content --cache-location node_modules/.cache/eslint/ src --quiet",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:rls": "vitest run --config vitest.rls.config.ts",
    "audit:verify": "tsx src/scripts/verify-audit-chains.ts",
    "audit:detach": "tsx src/scripts/detach-audit-partition.ts",
    "benchmark:worker": "tsx src/scripts/benchmarkWorkerHeap.ts",
    "audit:partitions": "tsx src/scripts/create-audit-partition.ts",
    "index:concurrent": "tsx src/scripts/create-index-concurrently.ts",
    "audit:dates": "tsx src/scripts/audit-date-formats.ts",
    "audit:timestamps": "tsx src/scripts/audit-timestamp-columns.ts",
    "audit:enrollment-ssot": "tsx src/scripts/audit-enrollment-ssot.ts",
    "audit:class-references": "tsx src/scripts/audit-class-references.ts",
    "audit:date-columns": "tsx src/scripts/audit-date-columns.ts",
    "audit:finance-date-columns": "tsx src/scripts/audit-finance-date-columns.ts",
    "audit:ledger-balance": "tsx src/scripts/audit-ledger-balance.ts",
    "audit:ledger-currency-balance": "tsx src/scripts/audit-ledger-currency-balance.ts",
    "audit:accounting-batch-runs": "tsx src/scripts/audit-accounting-batch-runs.ts",
    "audit:academic-contract": "tsx src/scripts/audit-academic-contract.ts",
    "backfill:attendance-sections": "tsx src/scripts/backfill-attendance-sections.ts",
    "backfill:date-columns": "tsx src/scripts/backfill-date-columns.ts",
    "purge:selected-modules": "tsx src/scripts/purgeSelectedModules.ts",
    "purge:orphaned-attachments": "tsx src/scripts/sweepOrphanedAttachments.ts",
    "test:db:coverage": "vitest run --config vitest.db.config.ts --coverage --coverage.include='src/sessions/**' --coverage.include='src/db/repositories/session*.ts' --coverage.include='src/routes/tenant/sessions/**' --coverage.include='src/worker/sessionLifecycleScheduler.ts' --coverage.reportsDirectory=coverage-sessions-db --coverage.reporter=json",
    "test:db:coverage:enrollments": "vitest run --config vitest.db.config.ts --coverage --coverage.include='src/enrollments/**' --coverage.include='src/db/repositories/enrollment*' --coverage.include='src/db/repositories/registration*' --coverage.include='src/routes/tenant/enrollments/**' --coverage.reportsDirectory=coverage-enrollments-db --coverage.reporter=json",
    "test:db:coverage:attendance": "vitest run --config vitest.db.config.ts --coverage --coverage.include='src/attendance/**' --coverage.include='src/db/repositories/attendance*' --coverage.include='src/routes/tenant/attendance/**' --coverage.reportsDirectory=coverage-attendance-db --coverage.reporter=json",
    "test:db:concurrency": "node ../../scripts/ci/run-concurrency-suite.mjs",
    "test:db:coverage:examinations": "vitest run --config vitest.db.config.ts --coverage --coverage.include='src/db/repositories/examination*' --coverage.include='src/examinations/domain/**' --coverage.reportsDirectory=coverage-examinations-db --coverage.reporter=json-summary --coverage.reporter=text-summary",
    "test:db:coverage:finance": "vitest run --config vitest.db.config.ts --coverage --coverage.include='src/finance/**' --coverage.include='src/accounting/**' --coverage.include='src/db/repositories/finance*' --coverage.include='src/db/repositories/accounting*' --coverage.include='src/routes/tenant/finance*' --coverage.include='src/routes/tenant/finance/**' --coverage.include='src/routes/tenant/accounting/**' --coverage.reportsDirectory=coverage-finance-db --coverage.reporter=json",
    "test:db:coverage:accounting": "vitest run --config vitest.db.config.ts --coverage --coverage.include='src/accounting/**' --coverage.include='src/db/repositories/accounting*' --coverage.include='src/routes/tenant/accounting/**' --coverage.reportsDirectory=coverage-accounting-db --coverage.reporter=json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1168.0",
    "@aws-sdk/lib-storage": "^3.1168.0",
    "@fastify/compress": "^9.3.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.2",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.7",
    "@fastify/multipart": "^10.1.8",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "@fastify/websocket": "^11.3.7",
    "@mms/shared": "workspace:*",
    "@ts-rest/core": "^3.52.1",
    "@ts-rest/fastify": "^3.52.1",
    "@ts-rest/open-api": "^3.52.1",
    "bullmq": "^6.7.6",
    "drizzle-orm": "catalog:",
    "exceljs": "^4.4.0",
    "fastify": "catalog:",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^6.0.0",
    "lru-cache": "^11.5.3",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "pino": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "5.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "5.0.5",
    "ws": "^8.23.0"
  }
}

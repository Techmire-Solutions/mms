{
  "name": "mms-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker": "tsx watch src/worker/index.ts",
    "worker:native": "node --experimental-strip-types src/worker/index.ts",
    "build": "tsc && rm -rf dist/db/migrations_drizzle && mkdir -p dist/db/migrations_drizzle && cp -r src/db/migrations_drizzle/. dist/db/migrations_drizzle/ && mkdir -p dist/worker/templates && cp -r src/worker/templates/. dist/worker/templates/",
    "start": "node dist/index.js",
    "worker:start": "node dist/worker/index.js",
    "db:reset": "tsx src/scripts/resetDb.ts",
    "db:migrate": "node dist/scripts/migrateDb.js 2>/dev/null || tsx src/scripts/migrateDb.ts",
    "db:check": "tsx src/scripts/checkMigrations.ts",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/typecheck.tsbuildinfo",
    "lint": "node -r ../../scripts/eslint-ts-compat.cjs node_modules/eslint/bin/eslint.js --cache --cache-strategy content --cache-location node_modules/.cache/eslint/ src --quiet",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:db": "vitest run --config vitest.db.config.ts",
    "audit:verify": "tsx src/scripts/verify-audit-chains.ts",
    "audit:detach": "tsx src/scripts/detach-audit-partition.ts",
    "benchmark:worker": "tsx src/scripts/benchmarkWorkerHeap.ts",
    "audit:partitions": "tsx src/scripts/create-audit-partition.ts",
    "index:concurrent": "tsx src/scripts/create-index-concurrently.ts",
    "audit:dates": "tsx src/scripts/audit-date-formats.ts",
    "purge:selected-modules": "tsx src/scripts/purgeSelectedModules.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/lib-storage": "^3.1146.0",
    "@fastify/compress": "^9.2.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@fastify/websocket": "^11.3.3",
    "@mms/shared": "workspace:*",
    "@ts-rest/core": "^3.52.1",
    "@ts-rest/fastify": "^3.52.1",
    "@ts-rest/open-api": "^3.52.1",
    "bullmq": "^6.3.11",
    "drizzle-orm": "catalog:",
    "exceljs": "^4.4.0",
    "fastify": "catalog:",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^6.0.0",
    "lru-cache": "^11.5.3",
    "nodemailer": "^10.0.14",
    "pg": "^8.23.1",
    "pino": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3",
    "ws": "^8.22.0"
  }
}

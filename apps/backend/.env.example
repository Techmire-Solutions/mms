# ==============================================================================
# MADRASA MANAGEMENT SYSTEM (MMS) — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to apps/backend/.env for local dev (never commit .env).
# Production: set the same keys as GitHub repository secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER & CRYPTOGRAPHIC SECURITY
# ------------------------------------------------------------------------------
# High-entropy 256-bit cryptographic hex key for Fastify JWT and session cookies.
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-256-bit-random-hex-key

# Preferred dedicated key for AES-256-GCM at-rest envelopes (LLM API keys, etc.).
# When unset, cryptoAtRest falls back to JWT_SECRET — JWT rotation then breaks
# existing ciphertext. Generate a separate 32-byte hex key for production.
# AT_REST_ENCRYPTION_KEY=change-me-to-a-dedicated-256-bit-random-hex-key

# Server Environment Mode: development | production | test
NODE_ENV=development

# Network Binding & Listening Ports
# Local Dev: PORT=3000 | Production Hetzner: PORT=5002 (behind Apache Proxy)
PORT=3000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 2. DATABASE & POOLING (PostgreSQL + Drizzle ORM)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mms
# Per-process connection pool. CONNECTION BUDGET: the backend and the worker are
# separate processes with their own pool, so the ceiling is 2 x PG_POOL_MAX
# (plus a few short-lived clients for migrations). Keep
#   2 x PG_POOL_MAX + headroom  <  Postgres max_connections
# e.g. 2 x 20 + headroom fits comfortably under the 200 set in docker-compose.yml.
PG_POOL_MAX=20
# Optional read replica. When set to a DIFFERENT URL than DATABASE_URL, read-only
# transactions (withTenantRead) use it; when unset or equal, reads share the
# primary pool. Note the replica gets its own pool of PG_POOL_MAX connections, so
# configuring this doubles the connection budget above.
# READ_REPLICA_DATABASE_URL=postgresql://postgres:postgres@replica:5432/mms
# Tenant-bound SET LOCAL budgets (skipped for migrations / admin RLS bypass)
PG_STATEMENT_TIMEOUT_MS=30000
PG_IDLE_IN_TX_TIMEOUT_MS=15000

# IAS 21 reference exchange rates fetched daily by the worker (comma list; empty = off).
#   ecb   - European Central Bank daily fixing (EUR base, keyless, no PKR)
#   erapi - open.er-api.com latest (USD base, keyless, includes PKR)
# Tenant-entered rates always win over feed rates.
# FX_RATE_FEED_PROVIDERS=ecb,erapi

# ------------------------------------------------------------------------------
# 2b. RATE LIMITING
# ------------------------------------------------------------------------------
# Baseline limit applied to EVERY route (requests per minute).
# Default: 300 in production, 10000 outside it.
# RATE_LIMIT_GLOBAL_MAX=300
# The in-process store is an accurate ceiling for a single backend process and
# keeps auth routes protected when Redis is down. Set this to true ONLY when
# running more than one backend process, so the limit is shared across them.
# RATE_LIMIT_REDIS_STORE=false

# ------------------------------------------------------------------------------
# 2c. OPERATIONAL METRICS (Prometheus)
# ------------------------------------------------------------------------------
# Exposes GET /metrics in the Prometheus text exposition format: HTTP request
# counts/latency by route pattern, DB pool saturation, Redis state, process
# memory, and event-loop lag. OFF by default — the payload reveals internal
# topology, so enable it deliberately and scrape over a private network.
# METRICS_ENABLED=false
# When the scrape path is not fully private, require a bearer token. Fails
# closed: if this is set, requests without the exact token get 401.
# METRICS_TOKEN=generate-one-with-openssl-rand-hex-24

# ------------------------------------------------------------------------------
# 2d. LOCAL-DEV CREDENTIAL LOGGING (development only)
# ------------------------------------------------------------------------------
# By default, one-time codes (2FA, login-email change) are NEVER written to logs:
# log streams are shipped, indexed and retained, so a credential in a log is a
# credential leak. Local development can opt in to seeing them. Requires
# NODE_ENV=development|test — anything else (production, staging, unset) fails
# closed, so a shared environment cannot leak real user OTPs by accident.
# MMS_LOG_DEV_CREDENTIALS=true

# ------------------------------------------------------------------------------
# 2e. GRACEFUL SHUTDOWN
# ------------------------------------------------------------------------------
# How long to report NOT READY before closing the socket, so whatever routes
# traffic can take this instance out of rotation. Size it against the ROUTER's
# health-check interval (not docker-compose's healthcheck, which is not used for
# routing). Behind Apache + a single pm2 instance nothing re-checks, so 0 is fine.
# SHUTDOWN_DRAIN_DELAY_MS=5000

# ------------------------------------------------------------------------------
# 3. DOMAINS, CORS & MULTI-TENANCY
# ------------------------------------------------------------------------------
# Frontend Application URL (used in email links and CORS validation)
PLATFORM_APP_URL=http://localhost:5173
ALLOWED_ORIGIN=http://localhost:5173

# Apex domain for tenant subdomains (e.g. {subdomain}.yourdomain.com)
# MMS_APP_DOMAIN=your-platform-domain.com

# ------------------------------------------------------------------------------
# 4. HTTP REQUEST LIMITS & PERFORMANCE
# ------------------------------------------------------------------------------
LOG_LEVEL=info
REQUEST_BODY_LIMIT_BYTES=1048576
REQUEST_TIMEOUT_MS=120000
MMS_SYNC_MAX_BODY_BYTES=52428800

# Security: Set TRUST_PROXY to trusted CIDRs/IPs in production (never 'true').
# TRUST_PROXY=127.0.0.1
COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL SERVICES (Resend or SMTP)
# ------------------------------------------------------------------------------
# Provider Option A: Resend API (Recommended for production)
# PLATFORM_RESEND_API_KEY=re_123456789

# Provider Option B: SMTP (e.g. Gmail App Password)
# PLATFORM_SMTP_HOST=smtp.gmail.com
# PLATFORM_SMTP_PORT=587
# PLATFORM_SMTP_SECURE=false
# PLATFORM_SMTP_USER=user@example.com
# PLATFORM_SMTP_PASS=app-password
PLATFORM_EMAIL_FROM=noreply@your-verified-domain.com
PLATFORM_EMAIL_FROM_NAME=MMS Platform

# ------------------------------------------------------------------------------
# 6. STORAGE & ASSET PATHS
# ------------------------------------------------------------------------------
# Local directory for uploads (logos, avatars, attachments). Default: ./uploads
# MMS_UPLOADS_DIR=/var/www/mmsv2/apps/backend/uploads

# ------------------------------------------------------------------------------
# 7. PLATFORM SUPERUSER BOOTSTRAP (Disabled by default for security)
# ------------------------------------------------------------------------------
PLATFORM_ALLOW_ENV_BOOTSTRAP=false
# PLATFORM_ADMIN_EMAIL=admin@your-domain.com
# PLATFORM_ADMIN_PASSWORD=SuperSecretPass123!
# PLATFORM_ADMIN_NAME=Platform Admin
# Opt-in: allow apex super_user POST /api/platform/admin/system/migrate-and-restart
# PLATFORM_ALLOW_REMOTE_MIGRATE_RESTART=true
#
# Mirrors the platform super_user password hash into every tenant as super_admin.
# Default is enabled when unset. Production deployments that do not need
# break-glass tenant login MUST set this to false — a compromised tenant DB
# exposes the platform super-user hash and the mirrored account can sign into
# every workspace. Prefer false unless you explicitly rely on this break-glass.
# PLATFORM_SYNC_SUPERUSER_TO_TENANTS=false
#
# Opt-in platform console 2FA (email OTP after password). When true, login
# issues a challenge instead of a session until OTP is verified.
# PLATFORM_REQUIRE_2FA=true
#
# Apex platform_activity_logs retention (days). Default 180.
# PLATFORM_ACTIVITY_LOG_RETENTION_DAYS=180

# ------------------------------------------------------------------------------
# 8. BACKGROUND JOB DISPATCH
# ------------------------------------------------------------------------------
# When the BullMQ queue is unreachable (Redis down/timeout), background jobs are
# rejected with HTTP 503 by default so heavy export/PDF work never runs on the API
# event loop (no sandbox, no heap ceiling, no retry/DLQ). Set true ONLY for local
# development to let the API process run the job in-process instead.
# MMS_ALLOW_IN_PROCESS_JOB_FALLBACK=true

# ------------------------------------------------------------------------------
# 9. DATABASE BOOT INITIALIZATION
# ------------------------------------------------------------------------------
# Boot initialization is serialized across PM2 cluster instances by a Postgres
# advisory lock, so concurrent replicas can never double-seed or race partitions.
# The deploy pipeline already runs `migrateDb.js` before restarting PM2; set this
# to true to skip the (now redundant) DDL + data migrations at API/worker boot.
# MMS_SKIP_BOOT_MIGRATIONS=false

# ------------------------------------------------------------------------------
# 10. TENANT ISOLATION (RLS) & CSP
# ------------------------------------------------------------------------------
# The schema enables FORCE ROW LEVEL SECURITY on every tenant table, but
# PostgreSQL exempts superusers and BYPASSRLS roles from all policies. The app
# therefore refuses to boot in production as such a role (strict is the default
# when NODE_ENV=production) unless you opt out explicitly here.
#
# Create a dedicated role and point DATABASE_URL at it:
#   CREATE ROLE mms_app LOGIN PASSWORD '<secret>' NOSUPERUSER NOBYPASSRLS;
#   GRANT USAGE ON SCHEMA public TO mms_app;
#   GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO mms_app;
#   ALTER DEFAULT PRIVILEGES IN SCHEMA public
#     GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO mms_app;
#
# strict = fail closed (production default) · warn = log an error and continue
# (non-production default) · off = single-tenant on-prem installs only.
# MMS_DB_ROLE_ENFORCEMENT=strict
#
# Extra WebSocket origins allowed by the Content-Security-Policy `connect-src`.
# Leave empty when the SPA talks to its own origin (the normal deployment); set
# it only when VITE_API_URL points the client at a separate API host.
# MMS_WS_ORIGINS=wss://api.example.com
